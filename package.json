{
  "name": "@onehux/sso",
  "version": "0.1.1",
  "description": "Node.js/TypeScript SDK for OneHux Accounts SSO (Authorization Code + PKCE, real hosted login page, RP-initiated logout).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onehux/onehux-sso-nodejs.git"
  },
  "homepage": "https://accounts.onehux.com",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "express": ">=4.18",
    "express-session": ">=1.17"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "express-session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.10.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
